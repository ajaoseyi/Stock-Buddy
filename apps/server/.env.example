# =============================================================================
# apps/server/.env.example
#
# Copy this file to `apps/server/.env` and fill in real values:
#
#     cp apps/server/.env.example apps/server/.env
#
# `.env` is gitignored; this file (names + docs, no secrets) is committed.
#
# CLAUDE.md §1 constrains everything below: this project runs on FREE TIERS
# ONLY. Each key's documented free-tier limit is recorded next to it, because
# `tools/cache.ts` TTLs (§6) are chosen to keep us under exactly these numbers.
# The web app (apps/web) never sees any of these — it is a pure client of this
# server's HTTP API (§9).
# =============================================================================


# -----------------------------------------------------------------------------
# LLM PROVIDERS
#
# Both are wired behind the single `getLlm()` factory in `src/llm.ts` (§2) —
# no node ever names a provider directly. Gemini is primary; Groq is the
# fast fallback used when Gemini returns a rate-limit error.
# -----------------------------------------------------------------------------

# Google Gemini 2.5 Flash — PRIMARY report-writing model.
# Get a key: https://aistudio.google.com/apikey
# Free tier (AI Studio): ~15 requests/min, 1,500 requests/day on Flash.
# Consumed only by `report-writer.ts` and `validator.ts` — the deterministic
# capability nodes never call an LLM at all (§1: "the LLM never computes a
# number"), so a single analyze request costs 1-2 LLM calls, not dozens.
GOOGLE_API_KEY=

# Which Gemini model to use. Optional — defaults to `gemini-flash-latest`.
#
# NOTE: `gemini-2.5-flash` (which CLAUDE.md §2 names) is RETIRED for new API
# keys — `generateContent` returns 404 "no longer available to new users", even
# though the model still appears in the /models list endpoint. Same for
# `gemini-2.5-flash-lite`. Verified models on a new key today:
#   gemini-flash-latest, gemini-flash-lite-latest, gemini-3.5-flash,
#   gemini-3.6-flash, gemini-3-flash-preview, gemini-3.1-flash-lite
#
# `gemini-flash-latest` is a moving alias to the current stable Flash, so it
# cannot go stale the way a pinned version just did. Pin a version here if you
# need reproducible prose.
GEMINI_MODEL=

# Groq — FALLBACK model provider, used when Gemini is rate-limited.
# Get a key: https://console.groq.com/keys
# Free tier: per-model RPM/TPD limits, generous for this workload.
GROQ_API_KEY=


# -----------------------------------------------------------------------------
# MARKET DATA PROVIDERS
# -----------------------------------------------------------------------------

# Alpha Vantage — used for TWO things in the industry-trend capability (§5.2):
#   1. the `SECTOR` endpoint, as a cross-check against the Yahoo sector ETF
#      trend signal (disagreement is recorded in `trendDataErrors`, never
#      silently resolved — §5.3);
#   2. `ETF_PROFILE`, the authoritative source of sector-ETF holding weights
#      that feed the weight score (§5.4).
# Get a key: https://www.alphavantage.co/support/#api-key
# Free tier: 25 requests/DAY and 5/minute. This is the tightest budget in the
# project by a wide margin — hence the 24h TTL on SECTOR and 7d TTL on
# ETF_PROFILE holdings (§6). If the daily quota is exhausted, the capability
# degrades to Yahoo-only rather than failing (§5.7).
ALPHA_VANTAGE_API_KEY=

# Finnhub — `stock/profile2`, mapping a ticker to its sector/industry (§5.2).
# Get a key: https://finnhub.io/register
# Free tier: 60 calls/minute. Cached indefinitely per ticker, since a
# company's sector tag effectively never changes (§6).
FINNHUB_API_KEY=

# NOTE: `yahoo-finance2` is the fourth data source and needs NO key. It is the
# primary source for both sector ETF price history and constituent OHLCV.
# It has no documented rate limit but is an unofficial upstream, so §5.2 says
# to cache it aggressively anyway (24h).


# -----------------------------------------------------------------------------
# SERVER RUNTIME
# -----------------------------------------------------------------------------

# Port for the Fastify server exposing POST /api/analyze (§7).
PORT=3001

# CORS allow-list (§7: "server allows only the Vite dev origin in development;
# tighten before any public deployment"). Comma-separated for multiple origins.
CORS_ORIGIN=http://localhost:5173

# `development` | `production`. Controls log verbosity, including the cache-miss
# logging that §6 requires so real API-call volume stays visible during dev.
NODE_ENV=development


# -----------------------------------------------------------------------------
# CAPABILITY TUNING — industry trend (§5)
# -----------------------------------------------------------------------------

# How many sectors from each end of the ranking get the Alpha Vantage
# cross-check, and get a leader breakdown (§5.4's "top N up, top N down").
#
# 3 means: top 3 rising + bottom 3 falling = 6 sectors, so 6 Alpha Vantage
# TIME_SERIES_DAILY calls per cold run against the 25/day cap (§5.8a). Raising
# this multiplies the quota cost by 2 per step, so 5 (=10 calls) is roughly the
# practical ceiling before holdings fetches no longer fit in the same day.
SECTOR_TREND_TOP_N=3

# Disagreement threshold for the Yahoo vs Alpha Vantage cross-check, in
# PERCENTAGE POINTS (§5.3: "disagree by more than a defined threshold").
#
# 0.5 means: Yahoo says +8.33% and Alpha Vantage says +8.61% → agree, marked
# "cross_checked". A gap wider than this is recorded in `trendDataErrors` and
# NEITHER source is silently preferred (§5.3). The two legitimately differ a
# little because they may use different adjustment conventions and slightly
# different session boundaries, so a threshold of 0 would flag every sector.
SECTOR_TREND_DISAGREEMENT_PCT=0.5


# -----------------------------------------------------------------------------
# CACHE (§6)
# -----------------------------------------------------------------------------

# Filesystem path to the better-sqlite3 cache database, relative to apps/server.
# Rebuildable by definition — safe to delete, and gitignored.
CACHE_DB_PATH=.cache/stock-buddy.sqlite

# Escape hatch for debugging a suspected stale-cache problem. Set to `true` to
# force every tool call to miss the cache and re-fetch.
# WARNING: this burns real free-tier quota fast — Alpha Vantage allows 25
# calls/DAY. Never commit this as `true`, and never leave uncached call paths
# in committed code (§9).
CACHE_BYPASS=false


# -----------------------------------------------------------------------------
# CONVERSATION PERSISTENCE (checkpointer)
# -----------------------------------------------------------------------------

# Where LangGraph stores per-thread conversation state. SEPARATE from the API
# cache above, deliberately: the cache is disposable and can be deleted any
# time to force a re-fetch, whereas deleting this destroys conversation
# history. Sharing one file would make "clear the cache" silently wipe threads.
CHECKPOINT_DB_PATH=.cache/checkpoints.sqlite

# How many checkpoints to retain per conversation thread.
#
# This is a RETENTION LIMIT, not a tuning knob to raise casually. One turn of
# this graph writes 7 checkpoints totalling ~125 KB — three of them carry the
# full sectorLeaders payload (~34 KB each) — and they ACCUMULATE rather than
# replace. Without pruning, 1,000 threads would reach roughly 287 MB.
#
# 10 keeps the latest turn complete plus headroom to resume an interrupted run.
# The state a follow-up needs always lives in the newest checkpoint, so pruning
# costs deep rewind history, never conversational continuity.
MAX_CHECKPOINTS_PER_THREAD=10
